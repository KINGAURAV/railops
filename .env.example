# Copy to .env and fill in the <...> values. Never commit .env.

# --- Vayu Object Storage (S3) — Steps 1, 4, 5 ---
AWS_ACCESS_KEY_ID=<your-access-key>
AWS_SECRET_ACCESS_KEY=<your-secret-key>
S3_ENDPOINT=<your-s3-endpoint>
S3_BUCKET_NAME=<your-bucket-name>
S3_DATASET_KEY=railway/railway_telemetry.csv
S3_MODEL_KEY=move-it/model.joblib

# --- Vayu MLflow — Steps 2, 4 ---
MLFLOW_TRACKING_URL=https://<your-mlflow-host>
MLFLOW_TRACKING_USERNAME=<your-mlflow-username>
MLFLOW_TRACKING_PASSWORD=<your-mlflow-password>

# --- Vayu Kafka — Steps 3, 7 ---
KAFKA_BROKER=<server-ip>:<port>
KAFKA_USERNAME=<your-kafka-username>
KAFKA_PASSWORD=<your-kafka-password>
KAFKA_TOPIC=railway_telemetry
KAFKA_COMMAND_TOPIC=railway_commands

# --- Vayu Model Serving — Step 7 (or set in the dashboard sidebar) ---
PREDICT_URL=https://<model-serving-endpoint>/v1/models/<model-id>:predict

# --- Vayu Container Registry — Step 8 ---
IMAGE_REGISTRY=<your-image-registry-hostname>
REGISTRY_PROJECT=<your-registry-project>
REGISTRY_USERNAME=<container-registry-username>
REGISTRY_PASSWORD=<container-registry-password>
VAYU_USERNAME=<your-vayu-username>
